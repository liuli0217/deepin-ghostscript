+    { 0x02060, 0x02060 },
+    { 0x0FE00, 0x0FE0F },
+    { 0x0FEFF, 0x0FEFF },
+};
+
+#define SASLPREP_B1_LEN 8
+
+/* C.2.2 specials (non-ASCII control chars not caught by category Cc) */
+static const saslprep_range saslprep_c22_specials[] = {
+    { 0x006DD, 0x006DD },
+    { 0x0070F, 0x0070F },
+    { 0x0180E, 0x0180E },
