+/* SASLprep (RFC 4013) implementation using libunistring.
+ *
+ * This replaces the former libidn stringprep() dependency.
+ * The RFC 3454 table data is derived from libidn's rfc3454.c
+ * (LGPL-3+/GPL-2+, compatible with ghostscript's AGPL-3).
+ *
+ * libunistring provides NFKC normalization, Unicode category
+ * checks, case folding, and bidi class queries — it is already
+ * installed as a transitive dependency of libidn2-0.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "pdf_saslprep.h"
+
+#ifdef HAVE_LIBUNISTRING
+
+#include <unitypes.h>
+#include <uninorm.h>
+#include <unistr.h>
+#include <unictype.h>
+#include <unicase.h>
+
+/* ---- RFC 3454 table data ---- */
+
+/* B.1: map-to-nothing (RFC 3454 Section B.1) */
